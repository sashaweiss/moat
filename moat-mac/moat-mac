#!/usr/bin/env python3
"""Runs agents inside macOS VMs (via tart), sharing output with the host as validated git patches."""

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import unicodedata
from datetime import datetime, timezone
from pathlib import Path

MOAT_HOME = Path(os.environ.get("MOAT_MAC_HOME", Path.home() / ".moat-mac"))
BASE_VM = "moat-mac-base"
BASE_IMAGE = "ghcr.io/cirruslabs/macos-tahoe-xcode:latest"
BASE_CPU = 6
BASE_MEMORY_MB = 12288
VM_PREFIX = "moat-mac-"
MAILBOX_TAG = "moatmail"
GUEST_MAILBOX = "~/mailbox"
GUEST_WORK = "~/work"

# We install Claude Code ourselves; the image also ships a Homebrew claude.
# Absolute path: this goes through shlex.quote, which defeats ~ expansion.
GUEST_CLAUDE = "/Users/admin/.local/bin/claude"

PATCH_RE = re.compile(r"^(\d{4})\.patch$")
BRANCH_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
MBOX_FROM_RE = re.compile(r"^From [0-9a-f]{40} ", re.M)
MAX_PATCH_BYTES = 10 * 1024 * 1024


def log(msg, file=sys.stdout):
    """Print a message. Extra lines emit indented under the first."""
    first, *rest = msg.split("\n")
    print(f"moat-mac: {first}", file=file)
    for line in rest:
        print(f"moat-mac:   {line}", file=file)


def warn(msg):
    """Print an error. Extra lines emit indented under the first."""
    log(f"error: {msg}", file=sys.stderr)


def die(msg, code=1):
    """Like warn, but exits."""
    warn(msg)
    sys.exit(code)


def confirm(prompt):
    """Ask for a y/n. Extra lines emit indented under the first."""
    log(prompt)
    try:
        answer = input("[y/n] ")
    except EOFError:
        answer = ""
    if answer.strip().lower() != "y":
        sys.exit(1)


# MARK: - tart

def tart(*args, **kwargs):
    return subprocess.run(["tart", *args], **kwargs)


def tart_list():
    out = tart(
        "list", "--source", "local", "--format", "json",
        stdout=subprocess.PIPE, text=True, check=True,
    )
    return json.loads(out.stdout or "[]")


def vm_exists(name):
    return any(vm["Name"] == name for vm in tart_list())


def vm_running(name):
    return any(vm["Name"] == name for vm in tart_list() if vm.get("Running"))


def vm_allocated_gb(vm):
    """A VM's allocated size in GB, from `tart get` (3-decimal precision)."""
    out = tart("get", vm, "--format", "json", capture_output=True, text=True)
    if out.returncode != 0:
        return None
    try:
        return float(json.loads(out.stdout)["Size"])
    except (ValueError, KeyError):
        return None


def vm_growth_gb(vm, base_gb):
    """GB a VM has grown since it was cloned: its allocated size, less the
    base image's. APFS copy-on-write means a fresh clone starts equal to
    its base, so the difference is what this VM alone has written."""
    allocated = vm_allocated_gb(vm)
    if allocated is None:
        return None
    if base_gb is None:
        return allocated
    return max(allocated - base_gb, 0.0)


def guest(vm, script, **kwargs):
    """Run a command in the VM as admin, in a login shell."""
    return subprocess.run(["tart", "exec", vm, "/bin/zsh", "-lc", script], **kwargs)


def wait_for_guest(vm, boot_proc):
    while True:
        ready = guest(vm, "true", stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if ready.returncode == 0:
            return
        if boot_proc.poll() is not None:
            die("tart run exited before the guest came up")
        time.sleep(2)


def stop_vm(vm):
    """Stop a VM, quieting tart's chatter but surfacing failures.
    Returns True on success."""
    stop = tart("stop", vm, capture_output=True, text=True)
    if stop.returncode != 0:
        warn(f"could not stop VM {vm}\n"
             + (stop.stderr.strip().split("\n")[0] if stop.stderr else "tart stop failed"))
        return False
    return True


def boot_vm(s):
    """Start the session VM with its mailbox mounted. Returns the process."""
    boot = subprocess.Popen(
        ["tart", "run", s.vm, "--no-graphics",
         "--dir", f"{s.mailbox}:tag={MAILBOX_TAG}"],
        stdin=subprocess.DEVNULL,
    )
    wait_for_guest(s.vm, boot)
    guest(
        s.vm,
        f"mkdir -p {GUEST_MAILBOX} && sudo mount_virtiofs {MAILBOX_TAG} {GUEST_MAILBOX}",
        check=True,
    )
    return boot


# MARK: - Sessions

class Session:
    def __init__(self, name):
        self.name = name
        self.dir = MOAT_HOME / name
        self.mailbox = self.dir / "mailbox"
        self.history = self.dir / "history"
        self.meta_path = self.dir / "session.json"
        self.vm = VM_PREFIX + name

    @property
    def exists(self):
        return self.meta_path.is_file()

    def load(self):
        return json.loads(self.meta_path.read_text())

    def save(self, meta):
        self.meta_path.write_text(json.dumps(meta, indent=2) + "\n")

    @property
    def branches_dir(self):
        return self.mailbox / "branches"

    @property
    def from_host_dir(self):
        return self.mailbox / "from-host"

    @property
    def shared_dir(self):
        return self.mailbox / "shared"

    def published_branches(self):
        """Validly-named, non-symlink branch directories in the mailbox."""
        found = []
        if not self.branches_dir.is_dir():
            return found
        for entry in sorted(os.scandir(self.branches_dir), key=lambda e: e.name):
            if not entry.is_dir(follow_symlinks=False):
                continue
            name = entry.name
            if BRANCH_RE.match(name) and ".." not in name and not name.endswith(".lock"):
                found.append(name)
        return found


def sessions_for_cwd():
    """Sessions whose repo contains the current directory."""
    cwd = Path.cwd().resolve()
    matches = []
    best_repo = None
    for s in all_sessions():
        repo = Path(s.load()["repo"])
        if cwd != repo and repo not in cwd.parents:
            continue
        # Prefer the innermost repo (worktrees nested under other repos).
        if best_repo is None or len(str(repo)) > len(str(best_repo)):
            matches, best_repo = [s], repo
        elif repo == best_repo:
            matches.append(s)
    return matches


def resolve_session(name):
    """Session from the argument, or from the current directory."""
    if name is not None:
        return load_session(name)
    matches = sessions_for_cwd()
    if not matches:
        die("no session for the current directory\n"
            "pass --session (see: moat-mac list)")
    if len(matches) > 1:
        names = ", ".join(s.name for s in matches)
        die(f"multiple sessions for the current directory ({names})\n"
            "pass --session to pick one")
    return matches[0]


def load_session(name):
    s = Session(name)
    if not s.exists:
        die(f'no session named "{name}" (see: moat-mac list)')
    return s


def all_sessions():
    if not MOAT_HOME.is_dir():
        return []
    return sorted(
        (Session(p.name) for p in MOAT_HOME.iterdir() if (p / "session.json").is_file()),
        key=lambda s: s.name,
    )


# MARK: - Patch validation

# Any Unicode text, except the "Other" (C*) categories: controls, which can
# drive a terminal; format characters, including bidi controls and invisible
# text, which can disguise code; and private-use or unassigned characters.
ALLOWED_CHARS = {
    "\n", "\t",
    "\u200d",  # Zero-width joiner, for emoji sequences
}


def disallowed_char(text):
    """Return the index of the first disallowed character, or None."""
    for i, ch in enumerate(text):
        if ch not in ALLOWED_CHARS and unicodedata.category(ch).startswith("C"):
            return i
    return None


# No binary files allowed, period.
BINARY_MARKERS = (
    re.compile(r"^GIT binary patch", re.M),
    re.compile(r"^Binary files .* differ$", re.M),
)


def validate_patch_text(text):
    """Raise ValueError unless text is a plain-text, binary-free patch."""
    i = disallowed_char(text)
    if i is not None:
        raise ValueError(f"disallowed character U+{ord(text[i]):04X} at offset {i}")
    for marker in BINARY_MARKERS:
        if marker.search(text):
            raise ValueError("contains a binary file change")


def validate_patch_file(path):
    """Validate a mailbox patch before its content is used for anything.

    Returns the decoded text; raises ValueError with a reason otherwise.
    """
    st = os.lstat(path)
    if not stat.S_ISREG(st.st_mode):
        raise ValueError("not a regular file (symlinks refused)")
    if st.st_uid != os.getuid():
        raise ValueError(f"unexpected owner uid {st.st_uid}")
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise ValueError("group- or world-writable")
    if st.st_size == 0:
        raise ValueError("empty file")
    if st.st_size > MAX_PATCH_BYTES:
        raise ValueError(f"too large ({st.st_size} bytes > {MAX_PATCH_BYTES})")

    data = Path(path).read_bytes()
    try:
        text = data.decode("utf-8", errors="strict")
    except UnicodeDecodeError as e:
        raise ValueError(f"not valid UTF-8: {e}")

    validate_patch_text(text)
    return text


# MARK: - Patch series

def split_series(text):
    """Split format-patch --stdout output into [(subject, section), ...]."""
    starts = [m.start() for m in MBOX_FROM_RE.finditer(text)]
    if not starts:
        raise ValueError("not in git format-patch (mbox) format")
    commits = []
    for i, start in enumerate(starts):
        end = starts[i + 1] if i + 1 < len(starts) else len(text)
        section = text[start:end]
        m = re.search(r"^Subject: (?:\[PATCH[^\]]*\] )?(.*)$", section, re.M)
        commits.append((m.group(1) if m else "(no subject)", section))
    return commits


def git_out(repo, *args, **kwargs):
    """Run git in repo, returning stripped stdout (checked)."""
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        stdout=subprocess.PIPE, text=True, check=True, **kwargs,
    ).stdout.strip()


def patch_id(repo, diff_text):
    """Stable identity of a change, independent of sha/committer/dates."""
    out = subprocess.run(
        ["git", "-C", str(repo), "patch-id", "--stable"],
        input=diff_text, stdout=subprocess.PIPE, text=True, check=True,
    ).stdout.split()
    return out[0] if out else None


def read_parent(s, branch):
    """What this branch builds on: (parent, fork), or None for the session
    base. `fork` counts the parent's commits this branch is based on.

    Raises ValueError if the PARENT file is unusable.
    """
    return parse_parent_file(s.branches_dir / branch / "PARENT", branch)


def parse_parent_file(path, branch):
    """Parse a PARENT file: a branch name, then its fork count."""
    if not path.is_file():
        return None
    st = os.lstat(path)
    if not stat.S_ISREG(st.st_mode):
        raise ValueError("PARENT is not a regular file")
    if st.st_size > 256:
        raise ValueError("PARENT is too large")
    lines = path.read_bytes().decode("utf-8", errors="replace").split("\n")
    name = lines[0].strip()
    if not BRANCH_RE.match(name) or ".." in name or name.endswith(".lock"):
        raise ValueError(f"PARENT names an invalid branch ({name!r})")
    if name == branch:
        raise ValueError("PARENT names the branch itself")
    fork = lines[1].strip() if len(lines) > 1 else ""
    if not fork:
        return (name, None)
    if not fork.isdigit() or int(fork) < 1:
        raise ValueError(f"PARENT has an invalid fork count ({fork!r})")
    return (name, int(fork))


def order_branches(s, branches):
    """Order branches parents-first. Returns (parents, ordered, skipped),
    where skipped is [(branch, reason)]."""
    published = set(branches)
    parents, skipped = {}, []
    for b in branches:
        try:
            parents[b] = read_parent(s, b)
        except ValueError as e:
            skipped.append((b, str(e)))
    for b in sorted(parents):
        parent = parents[b]
        if parent is not None and parent[0] not in published:
            skipped.append((b, f'its parent "{parent[0]}" is not published'))
            del parents[b]

    ordered = []
    while True:
        ready = [b for b in sorted(parents)
                 if b not in ordered
                 and (parents[b] is None or parents[b][0] in ordered)]
        if not ready:
            break
        ordered.extend(ready)
    for b in sorted(parents):
        if b not in ordered:
            skipped.append((b, "its parent could not be resolved"))
    return parents, ordered, skipped


def branch_tree(parents, ordered, skipped, prefix=""):
    """Lines drawing the branch tree, children indented under their parent."""
    children = {}
    for branch in ordered:
        parent = parents[branch]
        children.setdefault(parent[0] if parent else None, []).append(branch)

    lines = []

    def walk(parent, depth):
        for branch in children.get(parent, []):
            lines.append("  " * depth + f"- {prefix}{branch}")
            walk(branch, depth + 1)

    walk(None, 0)
    for branch, reason in skipped:
        lines.append(f"- {prefix}{branch} (skipped: {reason})")
    return lines


def branch_chain(s, branch):
    """A branch and its ancestors, ancestors first."""
    chain, seen = [], set()
    current = branch
    while current is not None and current not in seen:
        seen.add(current)
        chain.append(current)
        try:
            parent = read_parent(s, current)
        except ValueError:
            break
        current = parent[0] if parent else None
    return list(reversed(chain))


def read_series(s, branch):
    """Read and validate a published branch's patch series from the mailbox.

    Returns [(subject, section), ...]; raises ValueError with a reason.
    """
    branch_dir = s.branches_dir / branch
    numbered = {}
    for path in branch_dir.iterdir():
        m = PATCH_RE.match(path.name)
        if m:
            numbered[int(m.group(1))] = path
    if not numbered:
        raise ValueError("no patches")
    expected = list(range(1, len(numbered) + 1))
    if sorted(numbered) != expected:
        raise ValueError(f"patch numbering has gaps ({len(numbered)} files)")

    series = []
    for n in expected:
        text = validate_patch_file(numbered[n])
        commits = split_series(text)
        if len(commits) != 1:
            raise ValueError(f"{numbered[n].name} contains {len(commits)} "
                             "commits; expected exactly one")
        series.append(commits[0])
    return series


# MARK: - Commands

def bundle_repo(repo, branch, tar_path, verbose=False):
    """Pack a fresh single-branch clone of repo@branch, submodules populated
    from the source's local checkouts where possible (no network). Returns
    the tarball's sha256.
    """
    quiet = [] if verbose else ["--quiet"]
    with tempfile.TemporaryDirectory(prefix="moat-mac-bundle-") as tmp:
        clone_dir = Path(tmp) / repo.name
        subprocess.run(
            ["git", "clone", *quiet, "--single-branch", "--branch", branch,
             str(repo), str(clone_dir)],
            check=True,
        )
        gitmodules = clone_dir / ".gitmodules"
        if gitmodules.is_file():
            git = ["git", "-C", str(clone_dir)]
            subprocess.run([*git, "submodule", *quiet, "init"], check=True)
            entries = subprocess.run(
                ["git", "config", "--file", str(gitmodules),
                 "--get-regexp", r"^submodule\..*\.path$"],
                stdout=subprocess.PIPE, text=True, check=True,
            ).stdout
            for line in entries.splitlines():
                key, sm_path = line.split(" ", 1)
                name = key[len("submodule."):-len(".path")]
                source = repo / sm_path
                if (source / ".git").exists():
                    subprocess.run(
                        [*git, "config", f"submodule.{name}.url", str(source)],
                        check=True,
                    )
            subprocess.run(
                [*git, "-c", "protocol.file.allow=always",
                 "submodule", *quiet, "update", "--init", "--recursive"],
                check=True,
            )
            subprocess.run(
                [*git, "submodule", *quiet, "sync", "--recursive"],
                check=True,
            )

        # Uncompressed: the tarball only travels disk-to-disk, and gzip
        # dominates packing time on multi-GB repos.
        pack = subprocess.Popen(["tar", "-cf", str(tar_path), "-C", tmp, repo.name])
        while pack.poll() is None:
            time.sleep(2)
            size = tar_path.stat().st_size if tar_path.exists() else 0
            print("\rmoat-mac: packing repo bundle from temp dir into the mailbox... "
                  f"{size // (1024 * 1024)} MB", end="", flush=True)
        print()
        if pack.returncode != 0:
            die("tar failed while packing the repo bundle")
    sha = hashlib.sha256()
    with open(tar_path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            sha.update(chunk)
    return sha.hexdigest()


def require_base_vm():
    """Every session VM is cloned from the base image."""
    if not vm_exists(BASE_VM):
        die(f'base image "{BASE_VM}" is not installed\n'
            "install it with: moat-mac setup")


def cmd_setup(args):
    if vm_exists(BASE_VM):
        print(f'moat-mac: base image "{BASE_VM}" is already installed')
        return

    confirm(f"build the {BASE_VM} image?\n"
            f"- clones {BASE_IMAGE}\n"
            "- installs Claude Code into it\n"
            "**downloads ~25GB, and the finished VM needs ~80GB of disk**")

    print(f"moat-mac: cloning {BASE_IMAGE} -> {BASE_VM}")
    tart("clone", BASE_IMAGE, BASE_VM, check=True)
    tart("set", BASE_VM, "--cpu", str(args.cpu), "--memory", str(args.memory),
         check=True)

    print(f"moat-mac: booting VM {BASE_VM} for setup")
    boot = subprocess.Popen(
        ["tart", "run", BASE_VM, "--no-graphics"], stdin=subprocess.DEVNULL,
    )
    try:
        wait_for_guest(BASE_VM, boot)
        # Set PATH before installing, so the installer doesn't complain
        # about ~/.local/bin not being on it.
        print(f"moat-mac: VM configuring PATH")
        guest(BASE_VM,
              "echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.zprofile",
              check=True)
        print("moat-mac: VM installing latest Claude Code")
        guest(BASE_VM, "curl -fsSL https://claude.ai/install.sh | bash", check=True)
    except KeyboardInterrupt:
        print(file=sys.stderr)
        log(f'interrupted\nVM "{BASE_VM}" is **incomplete**\n'
            f"delete it and retry with: tart delete {BASE_VM}", file=sys.stderr)
        raise SystemExit(130)
    except subprocess.CalledProcessError:
        die(f'setup failed\nVM "{BASE_VM}" is **incomplete**\n'
            f"delete it and retry with: tart delete {BASE_VM}")
    finally:
        print(f"moat-mac: stopping VM {BASE_VM}")
        stop_vm(BASE_VM)
        boot.wait()

    log(f'base image "{BASE_VM}" ready\n'
        "create a session with: moat-mac create\n"
        "each new session needs a /login in claude on first start")


def cmd_create(args):
    repo = Path(args.repo).resolve()
    if not (repo / ".git").exists():
        die(f"{repo} is not a git repository")
    name = args.name or repo.name
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", name):
        die(f'invalid session name "{name}"')

    s = Session(name)
    if s.exists:
        die(f'session "{name}" already exists\n'
            "create another session for this repo with: moat-mac create --name NAME")
    if vm_exists(s.vm):
        die(f'VM "{s.vm}" already exists\ndelete it first with: tart delete {s.vm}')
    require_base_vm()

    current = git_out(repo, "rev-parse", "--abbrev-ref", "HEAD")
    if current == "HEAD":
        die("repo is on a detached HEAD\ncheck out a branch first")
    base_commit = git_out(repo, "rev-parse", "HEAD")

    # Both sides work on moat-mac/<session>/<branch>, so the session starts
    # from such a branch: reuse it if we are on one, else make it here.
    prefix = f"moat-mac/{name}/"
    if current.startswith(prefix):
        branch, session_ref, existing_ref = current[len(prefix):], current, True
    else:
        branch = re.sub(r"[^A-Za-z0-9._-]+", "-", current).strip("-.")
        if not branch:
            die(f'cannot make a session branch name from "{current}"')
        session_ref = prefix + branch
        existing_ref = subprocess.run(
            ["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", session_ref],
            stdout=subprocess.DEVNULL,
        ).returncode == 0
    if not BRANCH_RE.match(branch):
        die(f'cannot make a session branch name from "{current}"')
    if existing_ref:
        base_commit = git_out(repo, "rev-parse", session_ref)
        ref_line = f'- uses existing branch "{session_ref}"'
    else:
        ref_line = f'- creates branch "{session_ref}" from {current}'

    confirm(
        f'create session "{name}"?\n'
        f"{ref_line}\n"
        f'- clones VM "{BASE_VM}" -> "{s.vm}"\n'
        f"- seeds it with a single-branch clone of {repo} @ {session_ref} "
        f"({base_commit[:10]})\n"
        "**only files tracked by git on that branch will be included**"
    )

    s.mailbox.mkdir(parents=True)
    s.history.mkdir()
    s.save({
        "name": name,
        "repo": str(repo),
        "repo_name": repo.name,
        "branch": branch,
        "base_commit": base_commit,
        "created": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    })
    s.branches_dir.mkdir()
    s.from_host_dir.mkdir()
    s.shared_dir.mkdir()

    if not existing_ref:
        made = subprocess.run(
            ["git", "-C", str(repo), "branch", session_ref, base_commit],
            capture_output=True, text=True,
        )
        if made.returncode != 0:
            die(f'could not create branch "{session_ref}"\n'
                + (made.stderr.strip().split("\n")[0] if made.stderr
                   else "git branch failed"))
        print(f'moat-mac: created branch "{session_ref}" at {base_commit[:10]}')

    print(f"moat-mac: cloning {repo} to a temp dir (with submodules)")
    bundle_sha = bundle_repo(repo, session_ref, s.mailbox / "repo.tar", args.verbose)

    print(f"moat-mac: cloning VM {BASE_VM} -> {s.vm} (APFS copy-on-write)")
    tart("clone", BASE_VM, s.vm, check=True)

    # Provisioning also goes over the mailbox: it's the only channel in.
    provision = s.mailbox / ".provision"
    provision.mkdir()
    here = Path(__file__).resolve().parent
    shutil.copy(here / "guest" / "moat-publish", provision / "moat-publish")
    shutil.copy(here / "guest" / "moat-fetch", provision / "moat-fetch")
    shutil.copy(here / "guest" / "guest-setup.sh", provision / "guest-setup.sh")
    (provision / "config.json").write_text(json.dumps({
        "session": name,
        "repo_name": repo.name,
        "base_commit": base_commit,
        "branch": branch,
        "bundle_sha256": bundle_sha,
    }, indent=2) + "\n")
    claude_md = Path.home() / ".claude" / "CLAUDE.md"
    if claude_md.is_file():
        shutil.copy(claude_md, provision / "CLAUDE.md")

    print(f"moat-mac: booting VM {s.vm} for setup")
    boot = None
    try:
        boot = boot_vm(s)
        print("moat-mac: VM running guest setup")
        guest(s.vm, f"zsh {GUEST_MAILBOX}/.provision/guest-setup.sh", check=True)
        # Don't trust the exec channel's exit status alone: verify, host-side,
        # the marker guest-setup writes as its final act.
        if not (provision / ".complete").is_file():
            die("guest setup did not finish (no completion marker)\n"
                f'session "{name}" is **incomplete**\n'
                f"clean up and retry with: moat-mac delete --session {name}")
    except KeyboardInterrupt:
        print(file=sys.stderr)
        log(f'interrupted\nsession "{name}" is **incomplete**\n'
            f"clean up and retry with: moat-mac delete --session {name}", file=sys.stderr)
        raise SystemExit(130)
    except subprocess.CalledProcessError:
        die(f'guest setup failed\nsession "{name}" is **incomplete**\n'
            f"clean up and retry with: moat-mac delete --session {name}")
    finally:
        print(f"moat-mac: stopping VM {s.vm}")
        stop_vm(s.vm)
        if boot is not None:
            boot.wait()
        shutil.rmtree(provision, ignore_errors=True)
        (s.mailbox / "repo.tar").unlink(missing_ok=True)

    log(f'session "{name}" ready\nstart it with: moat-mac start --session {name}')


def cmd_start(args):
    s = resolve_session(args.session)
    require_base_vm()
    if not vm_exists(s.vm):
        die(f'VM "{s.vm}" is missing (was it deleted?)')
    if vm_running(s.vm):
        die(f"{s.vm} is already running\nshell in with: moat-mac shell --session {s.name}")

    meta = s.load()
    repo_name = meta["repo_name"]

    if args.no_claude:
        confirm(f'start session "{s.name}"?\n'
                f"- boots VM {s.vm}\n"
                "- leaves claude unstarted")
    else:
        confirm(f'start session "{s.name}"?\n'
                f"- boots VM {s.vm}\n"
                f'- runs claude with permission mode "{args.permission_mode}"')
    print(f"moat-mac: booting VM {s.vm}")
    boot = None
    try:
        boot = boot_vm(s)

        # Guest CLAUDE.md = host global CLAUDE.md + the environment addendum
        # (guest/CLAUDE-addendum.md).
        here = Path(__file__).resolve().parent
        intro = (here / "guest" / "CLAUDE-addendum.md").read_text().format(
            session=s.name,
            repo_name=repo_name,
            branch=meta["branch"],
            base_commit=meta["base_commit"],
        )
        claude_md = Path.home() / ".claude" / "CLAUDE.md"
        content = (claude_md.read_text() + "\n\n" if claude_md.is_file() else "") + intro
        guest(
            s.vm,
            f"mkdir -p ~/.claude && printf '%s' {shlex.quote(content)} > ~/.claude/CLAUDE.md",
            check=True,
        )

        # The agent must be able to commit; give it a git identity if the VM
        # has none.
        guest(
            s.vm,
            "git config --global user.email >/dev/null 2>&1 || "
            "(git config --global user.name 'Claude (moat-mac)' && "
            "git config --global user.email 'claude@moat-mac.invalid')",
            check=True,
        )

        # Seed first-run Claude settings (guest/claude-settings.json, via
        # guest/seed-claude-settings.py) and learn the VM's login state.
        seed = (here / "guest" / "seed-claude-settings.py").read_text()
        seed_settings = (here / "guest" / "claude-settings.json").read_text()
        seeded = guest(
            s.vm,
            f"python3 - {shlex.quote(repo_name)} {shlex.quote(seed_settings)} "
            f"<< 'PYEOF'\n{seed}\nPYEOF",
            stdout=subprocess.PIPE, text=True, check=True,
        )
        needs_login = "logged-out" in seeded.stdout

        if args.no_claude:
            log(f"VM up\nshell in with: moat-mac shell --session {s.name}\n"
                f"stop with: moat-mac stop --session {s.name}")
            boot.wait()
            return

        if needs_login:
            log("this VM is not logged into Claude\n"
                "claude will open its /login flow\n"
                "complete the login before working")
        # A session maps 1:1 to a claude conversation: once the VM has a
        # login (so a conversation exists), pick that conversation back up.
        claude = [
            GUEST_CLAUDE,
            "--permission-mode", args.permission_mode,
            "--model", args.model,
            *(["--continue"] if not needs_login else []),
            *args.claude_args,
            *(["/login"] if needs_login else []),
        ]
        subprocess.run([
            "tart", "exec", "-it", s.vm, "/bin/zsh", "-lc",
            f"cd {GUEST_WORK}/{shlex.quote(repo_name)} && exec " + " ".join(map(shlex.quote, claude)),
        ])
    finally:
        print(f"moat-mac: stopping VM {s.vm}")
        stop_vm(s.vm)
        if boot is not None:
            boot.wait()


def cmd_stop(args):
    s = resolve_session(args.session)
    confirm(f"stop VM {s.vm}?")
    if not stop_vm(s.vm):
        sys.exit(1)
    print(f"moat-mac: stopped VM {s.vm}")


def cmd_shell(args):
    s = resolve_session(args.session)
    if not vm_running(s.vm):
        die(f"{s.vm} is not running\n"
            f"boot it first with: moat-mac start --session {s.name} --no-claude")
