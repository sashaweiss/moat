def cmd_list(args):
    vms = {vm["Name"]: vm for vm in tart_list()}
    base_gb = vm_allocated_gb(BASE_VM) if BASE_VM in vms else None
    rows = []
    for s in all_sessions():
        meta = s.load()
        vm = vms.get(s.vm)
        rows.append({
            "name": s.name,
            "repo": meta["repo"],
            "branch": meta["branch"],
            "vm": s.vm,
            "state": vm["State"] if vm else "missing",
            "running": bool(vm and vm.get("Running")),
            "size_gb": vm_growth_gb(s.vm, base_gb) if vm else None,
            "mailbox": str(s.mailbox),
        })
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    if not rows:
        log("no sessions\ncreate one with: moat-mac create")
        return
    fmt = "{:<18} {:<10} {:<32} {}"
    print(fmt.format("SESSION", "STATE", "REPO", "SIZE"))
    # The base image isn't a session: it is never run, and every session's
    # size below is growth on top of it.
    if base_gb is not None:
        print(fmt.format("<base-vm>", "-", "-", f"{base_gb:.1f} GB"))
    home = str(Path.home())
    for r in rows:
        repo = r["repo"]
        if repo == home or repo.startswith(home + "/"):
            repo = "~" + repo[len(home):]
        size = f"{r['size_gb']:.1f} GB" if r["size_gb"] is not None else "-"
        print(fmt.format(r["name"], r["state"], repo, size))



def pull_branch(s, meta, branch, parent, force=False):
    """Update local branch moat-mac/<session>/<branch> from the mailbox,
    building on its parent branch when it has one.
    Returns True unless the branch had to be skipped."""
    repo = meta["repo"]
    base = meta["base_commit"]
    ref = f"moat-mac/{s.name}/{branch}"
    if parent is None:
        root, root_name = base, base[:10]
    else:
        name, fork = parent
        parent_ref = f"moat-mac/{s.name}/{name}"
        commits = git_out(repo, "rev-list", "--reverse", f"{base}..{parent_ref}").split()
        if fork is None:
            fork = len(commits)
        if fork > len(commits):
            warn(f'skipping "{ref}": it forks from commit {fork} of '
                 f'"{parent_ref}", which has only {len(commits)}')
            return False
        root = commits[fork - 1] if fork else base
        root_name = f'"{parent_ref}" commit {fork}'

    try:
        sections = read_series(s, branch)
    except ValueError as e:
        warn(f'skipping "{ref}": {e}')
        return False

    # The local branch is linear and append-only: its existing commits must
    # be a prefix of the series (compared by subject and patch-id, which
    # survive git-am's re-minting of shas).
    exists = subprocess.run(
        ["git", "-C", repo, "rev-parse", "--verify", "--quiet",
         f"refs/heads/{ref}"],
        stdout=subprocess.DEVNULL,
    ).returncode == 0
    existing = []
    if exists:
        out = git_out(repo, "rev-list", "--reverse", f"{root}..{ref}")
        existing = out.splitlines() if out else []

    diverged = None
    if len(existing) > len(sections):
        diverged = (f'"{ref}" has {len(existing)} commits but the mailbox '
                    f"has only {len(sections)}")
    else:
        for i, sha in enumerate(existing):
            subject, section = sections[i]
            have = git_out(repo, "log", "-1", "--format=%s", sha)
            if have != subject or patch_id(repo, git_out(repo, "show", sha)) != patch_id(repo, section):
                diverged = (f'commit {i + 1} ("{subject}") does not match '
                            f'{sha[:10]} on "{ref}"')
                break

    if diverged is not None:
        if not force:
            warn(f"{diverged}\n"
                 f'"{ref}" was rewritten in the VM\n'
                 "reset the local branch and re-pull with: "
                 f"moat-mac pull {branch} --session {s.name} --force")
            return False
        reset = subprocess.run(
            ["git", "-C", repo, "branch", "-f", ref, root],
            capture_output=True, text=True,
        )
        if reset.returncode != 0:
            warn(f'could not reset "{ref}" to {root_name}\n'
                 + (reset.stderr.strip().split("\n")[0] if reset.stderr
                    else "git branch -f failed"))
            return False
        dropped = "s" if len(existing) != 1 else ""
        print(f'moat-mac: reset "{ref}" to {root_name}, '
              f"dropping {len(existing)} commit{dropped}")
        existing = []

    new_sections = sections[len(existing):]
    if not new_sections:
        print(f'moat-mac: "{ref}" is up to date ({len(existing)} commits)')
        return True

    # git-am the new commits onto the tip in a throwaway worktree; the
    # user's checkout is never touched.
    tip = existing[-1] if existing else root
    with tempfile.TemporaryDirectory(prefix="moat-mac-pull-") as tmp:
        wt = str(Path(tmp) / "wt")
        to_apply = Path(tmp) / "new.patch"
        to_apply.write_text("".join(section for _, section in new_sections))
        subprocess.run(
            ["git", "-C", repo, "worktree", "add", "--detach", wt, tip],
            check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        try:
            am = subprocess.run(
                ["git", "-C", wt, "am", str(to_apply)],
                capture_output=True, text=True,
            )
            if am.returncode != 0:
                subprocess.run(
                    ["git", "-C", wt, "am", "--abort"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                warn(f'"{ref}" did not apply onto {tip[:10]}\n'
                     + (am.stderr.strip().split("\n")[0] if am.stderr else "git am failed"))
                return False
            head = git_out(wt, "rev-parse", "HEAD")
            update = subprocess.run(
                ["git", "-C", repo, "branch", "-f", ref, head],
                capture_output=True, text=True,
            )
            if update.returncode != 0:
                warn(f'could not update branch "{ref}"\n' + update.stderr.strip())
                return False
        finally:
            subprocess.run(
                ["git", "-C", repo, "worktree", "remove", "--force", wt],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )

    verb = "advanced by" if existing else "created with"
    total = len(existing) + len(new_sections)
    plural = "s" if len(new_sections) != 1 else ""
    print(f'moat-mac: "{ref}" {verb} {len(new_sections)} commit{plural} '
          f"({total} total)")
    return True


def cmd_pull(args):
    s = resolve_session(args.session)
    meta = s.load()
    branches = s.published_branches()
    if args.branch:
        if args.branch not in branches:
            die(f'no published branch "{args.branch}" in the mailbox')
        # A branch is built on its ancestors, so they come along.
        branches = [b for b in branch_chain(s, args.branch) if b in branches]
    if not branches:
        print("moat-mac: nothing published yet")
        return
    prefix = f"moat-mac/{s.name}/"
    parents, ordered, skipped = order_branches(s, branches)
    plural = "es" if len(branches) != 1 else ""
    confirm(
        f"pull {len(branches)} branch{plural} into {meta['repo']}?\n"
        + "\n".join(branch_tree(parents, ordered, skipped, prefix))
        + ("\n**--force resets branches rewritten in the VM, discarding "
           "local commits on them**" if args.force else "")
    )
    for branch, reason in skipped:
        warn(f'skipping "{prefix}{branch}": {reason}')

    pulled = set()
    failed = bool(skipped)
    for branch in ordered:
        parent = parents[branch]
        if parent is not None and parent[0] not in pulled:
            warn(f'skipping "{prefix}{branch}": '
                 f'its parent "{prefix}{parent[0]}" was not updated')
            failed = True
            continue
        if pull_branch(s, meta, branch, parent, args.force):
            pulled.add(branch)
        else:
            failed = True
    if failed:
        sys.exit(1)


def write_series(branch_dir, patches, parent):
    """Write a branch's per-commit patches and PARENT into the mailbox."""
    branch_dir.mkdir(parents=True, exist_ok=True)
    for i, text in enumerate(patches, start=1):
        path = branch_dir / f"{i:04d}.patch"
        if path.is_file() and path.read_text() == text:
            continue
        tmp = branch_dir / f".{i:04d}.patch.tmp"
        tmp.write_text(text)
        tmp.rename(path)
    for path in branch_dir.iterdir():
        m = PATCH_RE.match(path.name)
        if m and int(m.group(1)) > len(patches):
            path.unlink()
    parent_file = branch_dir / "PARENT"
    if parent:
        name, fork = parent
        tmp = branch_dir / ".PARENT.tmp"
        tmp.write_text(f"{name}\n{fork}\n")
        tmp.rename(parent_file)
    elif parent_file.exists():
        parent_file.unlink()


def cmd_push(args):
    """Write local moat-mac/<session>/* branches into the mailbox, so the
    agent can pick up commits or history rewrites made on the host."""
    s = resolve_session(args.session)
    meta = s.load()
    repo, base = meta["repo"], meta["base_commit"]
    prefix = f"moat-mac/{s.name}/"

    refs = git_out(repo, "for-each-ref", "--format=%(refname:short)",
                   f"refs/heads/{prefix}*").splitlines()
    names = [r[len(prefix):] for r in refs if r.startswith(prefix)]
    if not names:
        die(f'no "{prefix}*" branches in {repo}')
    if args.branch and args.branch not in names:
        die(f'no branch "{prefix}{args.branch}" in {repo}')

    # A branch's parent is whatever the mailbox already records, so the
    # structure the agent published survives commits made here.
    recorded = {}
    for published in s.published_branches():
        try:
            recorded[published] = read_parent(s, published)
        except ValueError:
            recorded[published] = None

    depths = {n: int(git_out(repo, "rev-list", "--count", f"{base}..{prefix}{n}"))
              for n in names}
    parents = {}
    for name in names:
        if name in recorded:
            known = recorded[name]
            parents[name] = None
            if known and known[0] in names:
                fork = git_out(repo, "merge-base", prefix + known[0], prefix + name)
                shared = int(git_out(repo, "rev-list", "--count", f"{base}..{fork}"))
                if shared:
                    parents[name] = (known[0], shared)
            continue
        # Never published: infer, letting only a shorter branch (ties broken
        # by name) be the parent so two branches cannot claim each other.
        best, deepest = None, 0
        for other in names:
            # Only a shorter branch (ties broken by name) can be the parent,
            # so two branches can never claim each other.
            if other == name or (depths[other], other) >= (depths[name], name):
                continue
            fork = git_out(repo, "merge-base", prefix + other, prefix + name)
            if not fork or fork == git_out(repo, "rev-parse", prefix + name):
                continue
            shared = int(git_out(repo, "rev-list", "--count", f"{base}..{fork}"))
            if shared > deepest:
                best, deepest = (other, shared), shared
        parents[name] = best

    if args.branch:
        chain, current = [], args.branch
        while current is not None and current not in chain:
            chain.append(current)
            parent = parents[current]
            current = parent[0] if parent else None
        selected = list(reversed(chain))
    else:
        selected = sorted(names, key=lambda n: len(branch_chain_local(parents, n)))

    series, empty = {}, []
    for name in selected:
        ref = prefix + name
        if parents[name] is None:
            root = base
        else:
            root = git_out(repo, "merge-base", prefix + parents[name][0], ref)
        if git_out(repo, "rev-list", "--merges", f"{root}..{ref}"):
            die(f'"{ref}" contains merge commits\n'
                "published history must be linear (rebase to flatten it)")
        shas = git_out(repo, "rev-list", "--reverse", f"{root}..{ref}").split()
        if not shas:
            where = f'"{prefix}{parents[name][0]}"' if parents[name] else base[:10]
            if args.branch:
                die(f'"{ref}" has no commits beyond {where}\nnothing to push')
            empty.append(name)
            continue
        patches = []
        for sha in shas:
            text = git_out(repo, "format-patch", "-1", "--stdout", sha)
            try:
                validate_patch_text(text)
            except ValueError as e:
                die(f'"{prefix}{name}" commit {sha[:10]} cannot be pushed: {e}')
            patches.append(text)
        series[name] = patches

    for name in empty:
        print(f'moat-mac: nothing to push on "{prefix}{name}"')
    ordered = [n for n in selected if n in series]
    if not ordered:
        die("no branch has commits to push")
    plural = "es" if len(ordered) != 1 else ""
    confirm(
        f'push {len(ordered)} branch{plural} into the mailbox of session "{s.name}"?\n'
        + "\n".join(branch_tree(parents, ordered, [], prefix))
    )
    for name in ordered:
        write_series(s.from_host_dir / name, series[name], parents[name])
        count = len(series[name])
        print(f'moat-mac: pushed "{prefix}{name}" '
              f"({count} commit{'s' if count != 1 else ''})")
    log("the agent picks these up in the VM with: moat-fetch")


def branch_chain_local(parents, name):
    """A branch and its ancestors, from the parents map."""
    chain, current = [], name
    while current is not None and current not in chain:
        chain.append(current)
        parent = parents.get(current)
        current = parent[0] if parent else None
    return chain


def cmd_share(args):
    s = resolve_session(args.session)
    sources = []
    for f in args.files:
        src = Path(f)
        if src.is_dir():
            die(f"{src} is a directory\nshare individual files instead")
        if not src.is_file():
            die(f"{src} is not a file")
        if (s.shared_dir / src.name).exists():
            die(f"{src.name} is already shared")
        sources.append(src)

    plural = "s" if len(sources) != 1 else ""
    confirm(
        f'share {len(sources)} file{plural} into the mailbox of session "{s.name}"?\n'
        + "\n".join(f"- {src}" for src in sources)
    )
    s.shared_dir.mkdir(exist_ok=True)
    for src in sources:
        shutil.copy(src, s.shared_dir / src.name)
        print(f"moat-mac: shared {src.name} -> mailbox/shared")


def cmd_delete(args):
    s = resolve_session(args.session)
    confirm(f'delete session "{s.name}"?\n'
            f"- deletes VM {s.vm}\n"
            "- deletes the mailbox and all pulled patch history")
    if vm_exists(s.vm):
        tart("delete", s.vm, check=True)
    shutil.rmtree(s.dir)
    print(f'moat-mac: deleted session "{s.name}"')


def main():
    parser = argparse.ArgumentParser(prog="moat-mac", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("setup", help="install the base VM image that sessions are cloned from")
    p.add_argument("--cpu", type=int, default=BASE_CPU, metavar="N",
                   help=f"CPU count for the base image (default: {BASE_CPU})")
    p.add_argument("--memory", type=int, default=BASE_MEMORY_MB, metavar="MB",
                   help=f"memory for the base image (default: {BASE_MEMORY_MB})")
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser("create", help="create a session from a fresh clone of a repo")
    p.add_argument("--repo", default=".", metavar="PATH",
                   help="git repo to seed the session with (default: current directory)")
    p.add_argument("--name", metavar="NAME",
                   help="session name (default: the repo directory name)")
    p.add_argument("--verbose", action="store_true")
    p.set_defaults(func=cmd_create)

    p = sub.add_parser("start", help="boot a session VM and run claude in it")
    p.add_argument("--session", metavar="NAME",
                   help="session to target (default: the current directory's session)")
    p.add_argument("--no-claude", action="store_true",
                   help="boot the VM without launching claude")
    p.add_argument("--permission-mode", default="auto", metavar="MODE",
                   help="Claude Code permission mode (default: auto; see claude for allowed values)")
    p.add_argument("--model", default="opus", metavar="MODEL",
                   help="Claude model for the session (default: opus; see claude for allowed values)")
    p.add_argument("claude_args", nargs="*", help="extra arguments forwarded to claude")
    p.set_defaults(func=cmd_start)

    p = sub.add_parser("stop", help="stop a session VM")
    p.add_argument("--session", metavar="NAME",
                   help="session to target (default: the current directory's session)")
    p.set_defaults(func=cmd_stop)

    p = sub.add_parser("shell", help="shell into a running session VM")
    p.add_argument("--session", metavar="NAME",
                   help="session to target (default: the current directory's session)")
    p.set_defaults(func=cmd_shell)

    p = sub.add_parser("list", help="list sessions")
    p.add_argument("--json", action="store_true", help="output sessions as JSON")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("pull", help="update local moat-mac/<name>/* branches from the mailbox")
    p.add_argument("branch", nargs="?", help="pull only this published branch")
    p.add_argument("--force", action="store_true",
                   help="reset branches rewritten in the VM instead of skipping them")
    p.add_argument("--session", metavar="NAME",
                   help="session to target (default: the current directory's session)")
    p.set_defaults(func=cmd_pull)

    p = sub.add_parser("push", help="write local moat-mac/<name>/* branches into the mailbox")
    p.add_argument("branch", nargs="?", help="push only this branch and its ancestors")
    p.add_argument("--session", metavar="NAME",
                   help="session to target (default: the current directory's session)")
    p.set_defaults(func=cmd_push)

    p = sub.add_parser("share", help="share files from the host into the mailbox")
    p.add_argument("--file", dest="files", action="append", required=True,
                   metavar="PATH", help="file to copy into the mailbox (repeatable)")
    p.add_argument("--session", metavar="NAME",
                   help="session to target (default: the current directory's session)")
    p.set_defaults(func=cmd_share)

    p = sub.add_parser("delete", help="delete a session's VM, mailbox, and patch history")
    p.add_argument("--session", metavar="NAME",
                   help="session to target (default: the current directory's session)")
    p.set_defaults(func=cmd_delete)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
