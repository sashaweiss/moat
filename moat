#!/usr/bin/env python3
"""moat — run Claude Code in a sandboxed Apple `container` VM."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path


def resolve_git_common_dir(workspace: Path) -> Path | None:
    """
    Return the common .git/ directory to mount read-only for `workspace`, or
    None if `workspace` isn't inside a git repo. This is the workspace's own
    .git/ for a normal repo, or the original repo's shared .git/ for a worktree.
    """
    result = subprocess.run(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
        cwd=workspace,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    if result.returncode != 0:
        return None
    return Path(result.stdout.strip())


def find_git_dirs(root: Path) -> list[Path]:
    """
    Return all .git/ directories at or below `root`. Does not include or follow
    symlinks.
    """
    git_dirs = []
    for dirpath, dirnames, _ in os.walk(root):
        if ".git" in dirnames:
            dirnames.remove(".git")
            git_dir = Path(dirpath) / ".git"
            if not git_dir.is_symlink():
                git_dirs.append(git_dir)
    return git_dirs


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="moat",
        description="Runs Claude Code in a sandboxed VM with the given <workspace> directory mounted.",
        epilog="Any additional arguments are forwarded to `claude` inside the container.",
    )
    parser.add_argument(
        "workspace",
        help="directory to mount as the workspace in the container",
    )
    parser.add_argument(
        "--permission-mode",
        default="auto",
        help="Claude Code permission mode (default: auto)",
    )
    parser.add_argument(
        "--add-skill",
        metavar="DIR",
        action="append",
        default=[],
        help="skill directory to mount into the container, in addition to the "
        "host's ~/.claude/skills",
    )
    parser.add_argument(
        "--git-access-mode",
        choices=["read", "write"],
        default="read",
        help="mount the git directory read-only or read-write (default: read)",
    )
    parser.add_argument(
        "--env-file",
        metavar="PATH",
        help="file of KEY=VALUE secrets to inject as environment variables"
    )
    parser.add_argument(
        "--model",
        default="opus",
        help="Claude model for the session; defaults to the latest Opus (default: opus)",
    )
    parser.add_argument(
        "--no-settings",
        action="store_true",
        help="don't seed new sessions with the host's ~/.claude/settings.json",
    )
    args, claude_args = parser.parse_known_args()
    permission_mode = args.permission_mode
    git_write = args.git_access_mode == "write"
    model = args.model

    workspace_arg = Path(args.workspace)
    if not workspace_arg.is_dir():
        print(f"moat: not a directory: {args.workspace}", file=sys.stderr)
        return 1
    workspace = workspace_arg.resolve()

    env_file: Path | None = None
    if args.env_file is not None:
        env_file_arg = Path(args.env_file)
        if not env_file_arg.is_file():
            print(f"moat: not a file: {args.env_file}", file=sys.stderr)
            return 1
        env_file = env_file_arg.resolve()

    # Mount skills individually, keyed by name, so symlinked skills work.
    skills: dict[str, Path] = {}
    host_skills_dir = Path.home() / ".claude" / "skills"
    if host_skills_dir.is_dir():
        for skill in host_skills_dir.iterdir():
            if skill.is_dir() and not skill.name.startswith("."):
                skills[skill.name] = skill.resolve()
    for skill_arg in args.add_skill:
        if not Path(skill_arg).is_dir():
            print(f"moat: not a directory: {skill_arg}", file=sys.stderr)
            return 1
        skill = Path(skill_arg).resolve()
        if skill.name in skills:
            print(f"moat: duplicate skill: {skill.name}", file=sys.stderr)
            return 1
        skills[skill.name] = skill

    print(f"moat: run claude in \"{workspace.name}\" with permission mode \"{permission_mode}\"?")
    if git_write:
        print("WARNING: claude will have write access to git!")
    try:
        answer = input("[y/n] ")
    except (EOFError, KeyboardInterrupt):
        print()
        return 1
    if answer.strip().lower() != "y":
        return 1

    # Prepare directories for moat to store state.
    sessions_dir = moat_dir / "sessions"
    sessions_dir.mkdir(parents=True, exist_ok=True)

    # Because a Mac host can't easily share auth credentials with Claude in a
    # VM because of how it uses the keychain (see: https://github.com/anthropics/claude-code/issues/1414),
    # we'll store the in-VM auth credentials in ~/.moat so we can share them
    # across moat sessions.
    credentials_path = moat_dir / "credentials.json"
    credentials_path.touch(exist_ok=True)

    # Prepare a per-workspace (keyed by a hash of the directory path) directory
    # where we can save the ~/.claude directories from the VM durably on the
    # host, under ~/.moat/sessions. We'll mount this into the VM, so Claude has context
    # from and can resume previous sessions in this workspace.
    workspace_hash = hashlib.sha256(str(workspace).encode()).hexdigest()[:16]
    state_dir = sessions_dir / workspace_hash
    state_dir.mkdir(parents=True, exist_ok=True)

    # We'll mount the workspace in the container at the same absolute path as on
    # the host, and run Claude from there. We'll also mount the workspace's
    # "common git dir" (either .git/, or if we're a worktree then the .git/ of
    # the main worktree) at its absolute path as on the host.
    #
    # This ensures that git operations in the workspace work as the do on the
    # host, without having to worry about the paths a worktree (or any
    # submodules, or submodules in a worktree) might expect for .git contents.
    git_dir = resolve_git_common_dir(workspace)

    # We mount the git dir read-only by default so that all changes made inside
    # the moat session are obvious from the host (no possibility for commits,
    # ignoring, etc.).
    #
    # However, if specifically requested we'll allow git dir write access.
    git_mount_mode = "rw" if git_write else "ro"

    # Also apply the git mount mode to any nested repos in the workspace (e.g.,
    # independent clones), since they'd otherwise be writable via the workspace
    # mount.
    git_mounts = [git_dir] if git_dir else []
    for nested_git_dir in find_git_dirs(workspace):
        if nested_git_dir not in git_mounts:
            git_mounts.append(nested_git_dir)

    # For first-time workspaces, write a dummy .claude.json to populate some
    # default settings (silence FRE prompts). We'll store it in the state
    # directory, then mount it into the container at ~/.claude.json.
    claude_json_path = sessions_dir / f"{workspace_hash}.claude.json"
    if not claude_json_path.exists():
        claude_json_path.write_text(json.dumps({
            "hasCompletedOnboarding": True,
            "hasSeenAutoModeEntryWarning": True,
            "spinnerTipsEnabled": False,
            "projects": {
                str(workspace): {
                    "hasTrustDialogAccepted": True,
                },
            },
        }))

    # Likewise, seed a settings.json into the state directory, which is mounted
    # at ~/.claude. Use the host's ~/.claude/settings.json if present.
    settings_path = state_dir / "settings.json"
    if not settings_path.exists():
        settings = {}
        user_settings_path = Path.home() / ".claude" / "settings.json"
        if not args.no_settings and user_settings_path.exists():
            try:
                settings = json.loads(user_settings_path.read_text())
            except json.JSONDecodeError as e:
                print(f"moat: invalid JSON in {user_settings_path}: {e}", file=sys.stderr)
                return 1
            if not isinstance(settings, dict):
                print(f"moat: expected a JSON object in {user_settings_path}", file=sys.stderr)
                return 1
        # Always set autoMemoryDirectory, since that's part of the moat integration.
        settings["autoMemoryDirectory"] = "~/.claude/memory"
        settings_path.write_text(json.dumps(settings, indent=2))

    # Populate the VM's CLAUDE.md with a prefix describing the moat environment,
    # followed by the contents of the host's ~/.claude/CLAUDE.md.
    claude_md_content = (Path(__file__).resolve().parent / "CLAUDE-PROLOGUE.md").read_text()
    host_claude_md = Path.home() / ".claude" / "CLAUDE.md"
    if host_claude_md.is_file():
        claude_md_content += "\n\n" + host_claude_md.read_text()
    claude_md_path = sessions_dir / f"{workspace_hash}.CLAUDE.md"
    claude_md_path.write_text(claude_md_content)

    # For debugging purposes, write a pointer from the workspace hash back to
    # the workspace itself. This isn't mounted into the container.
    workspace_hash_hint_path = sessions_dir / f"{workspace_hash}.pointer"
    workspace_hash_hint_path.write_text(str(workspace))

    # If container's daemon isn't running yet, start it.
    status = subprocess.run(
        ["container", "system", "status"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if status.returncode != 0:
        subprocess.run(["container", "system", "start"], check=True)

    cmd = [
        "container", "run", "-it", "--rm",
        "--name", f"moat.{workspace.name}",
        "--cpus", "2", "--memory", "4G",
        "-u", "robot",
        "-w", str(workspace),
    ]

    if env_file:
        cmd += ["--env-file", str(env_file)]

    cmd += ["-v", f"{state_dir}:/home/robot/.claude:rw"]
    cmd += ["-v", f"{credentials_path}:/home/robot/.claude/.credentials.json:rw"]
    cmd += ["-v", f"{claude_json_path}:/home/robot/.claude.json:rw"]
    cmd += ["-v", f"{claude_md_path}:/home/robot/.claude/CLAUDE.md:ro"]

    # Skills are read-only, so any .git/ directories in them are too.
    for name, skill in skills.items():
        cmd += ["-v", f"{skill}:/home/robot/.claude/skills/{name}:ro"]

    # Mounts nested inside other mounts must come after their parent.
    cmd += ["-v", f"{workspace}:{workspace}:rw"]
    for d in git_mounts:
        cmd += ["-v", f"{d}:{d}:{git_mount_mode}"]

    cmd += [
        "moat:latest",
        "claude",
        "--permission-mode", permission_mode,
        "--model", model,
        *claude_args,
    ]
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    sys.exit(main())
